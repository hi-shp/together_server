# 기존 .env를 덮어쓰지 말고 누락된 항목만 추가하세요.
# 기존 웹훅 값은 ops/configure_webhooks.py로 서버 안에서 그대로 이전합니다.
WEBHOOK_URL=
DISCORD_LOG_WEBHOOK_URL=
DISCORD_NIGHT_WEBHOOK_URL=
DISCORD_MESSAGE_WEBHOOK_URL=
DISCORD_EMAIL_WEBHOOK_URL=

# 기존 서버의 값을 그대로 사용하세요.
GPT_API_KEY=
PLATO_ID=
PLATO_PW=
CHROME_DRIVER_PATH=/home/ubuntu/together/Source/chromedriver
WINDOW_SIZE=1920,1080
USER_AGENT=
PAGE_NAME=pages.csv

# 선택 설정. 기존 서버에서는 적용 과정에서 준비하며, 비워도 기본값을 사용합니다.
GPT_CATEGORY_MODEL=gpt-5.4-mini-2026-03-17
GPT_DUPLICATE_MODEL=gpt-5.4-mini-2026-03-17
NOTICE_CLASSIFIER_MODE=hybrid
NOTICE_DUPLICATE_MODE=hybrid
# shadow는 원문 후보를 비교해 기록하며 기존 게시물을 수정하지 않습니다.
NOTICE_INTELLIGENCE_MODE=off
# 생략하면 .runtime/intelligence/category-model.json.gz를 찾습니다.
NOTICE_CLASSIFIER_PATH=
# enabled이면 이후 직접 게시하고 등록한 공지만 자동 보강합니다.
NOTICE_ENRICHMENT_MODE=off

# 게시 검증, 첨부 보관과 알림 전송
POST_VALIDATION_MODE=enabled
PLATO_NOTIFICATION_TRANSPORT=http
PLATO_EMAIL_MODE=queue
ATTACHMENT_CACHE_GB=10
ATTACHMENT_MIN_FREE_GB=5
GPT_DAILY_BUDGET_USD=0.25

# 주요 장애 알림을 받을 주소. 기본 운영 대기는 정상 상태로 처리합니다.
ALERT_EMAIL_TO=
OPERATIONS_EXPECT_CRAWLER=0

# 1은 요청 순서대로 처리합니다. 0은 순서보다 동시 처리를 우선할 때 사용합니다.
PLATO_EMAIL_CONCURRENCY=1
